ast(source as varchar) as source\r\nfrom read_parquet(\r\n    'data/bronze/bank_of_canada/cpi/cpi.parquet'\r\n)", "relation_name": "\"ottawa_housing\".\"main\".\"stg_cpi\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T21:41:33.993344Z", "completed_at": "2026-11-09T21:41:33.996655Z"}, {"name": "execute", "started_at": "2026-11-09T21:41:33.997301Z", "completed_at": "2026-11-09T21:41:34.032031Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04094219207763672, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.ottawa_housing.int_annual_cpi", "compiled": true, "compiled_code": "select\n    extract(year from reference_date)::integer as reference_year,\n    avg(cpi_value) as annual_average_cpi\nfrom \"ottawa_housing\".\"main\".\"stg_cpi\"\ngroup by\n    extract(year from reference_date)::integer\norder by\n    reference_year", "relation_name": "\"ottawa_housing\".\"main\".\"int_annual_cpi\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T21:41:34.036045Z", "completed_at": "2026-11-09T21:41:34.038639Z"}, {"name": "execute", "started_at": "2026-11-09T21:41:34.039053Z", "completed_at": "2026-11-09T21:41:34.070767Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.03618907928466797, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.ottawa_housing.mart_housing_affordability", "compiled": true, "compiled_code": "with rents as (\n\n    select\n        reference_year,\n        geography,\n        structure_type,\n        unit_type,\n        rent_value,\n        lag(rent_value) over (\n            partition by geography, structure_type, unit_type\n            order by reference_year\n        ) as previous_rent\n    from \"ottawa_housing\".\"main\".\"stg_cmhc_rents\"\n\n),\n\ncpi as (\n\n    select\n        reference_year,\n        annual_average_cpi,\n        lag(annual_average_cpi) over (\n            order by reference_year\n        ) as previous_cpi\n    from \"ottawa_housing\".\"main\".\"int_annual_cpi\"\n\n)\n\nselect\n    rents.reference_year,\n    rents.geography,\n    rents.structure_type,\n    rents.unit_type,\n    rents.rent_value,\n    cpi.annual_average_cpi,\n\n    case\n        when rents.previous_rent is not null\n        then 100.0\n            * (rents.rent_value - rents.previous_rent)\n            / rents.previous_rent\n    end as rent_growth_percent,\n\n    case\n        when cpi.previous_cpi is not null\n        then 100.0\n            * (cpi.annual_average_cpi - cpi.previous_cpi)\n            / cpi.previous_cpi\n    end as cpi_growth_percent,\n\n    rents.rent_value\n        / nullif(cpi.annual_average_cpi, 0)\n        * 100 as rent_in_2002_cpi_dollars\n\nfrom rents\ninner join cpi\n    on rents.reference_year = cpi.reference_year", "relation_name": "\"ottawa_housing\".\"main\".\"mart_housing_affordability\"", "batch_results": null, "overload_results": null}], "elapsed_time": 0.5380914211273193, "args": {"source_freshness_run_project_hooks": true, "use_catalogs_v2": false, "show_resource_report": false, "require_batched_execution_for_custom_microbatch_strategy": true, "invocation_command": "dbt run --project-dir dbt_project --profiles-dir dbt_project --select +mart_housing_affordability --no-partial-parse", "upload_to_artifacts_ingest_api": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "maximum_seed_size_mib": 1, "require_yaml_configuration_for_mf_time_spines": true, "quiet": false, "version_check": true, "select": ["+mart_housing_affordability"], "partial_parse_file_diff": true, "require_generic_test_arguments_property": true, "use_colors_file": true, "introspect": true, "indirect_selection": "eager", "skip_nodes_if_on_run_start_fails": true, "state_modified_compare_vars": false, "use_fast_test_edges": false, "support_c